# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# Admin password: unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
WHISPER_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
WHISPER_PORT=9230

# Compose only: API copies behind nginx. Each copy holds the model in RAM (about 0.5 GB for base.en).
WHISPER_REPLICAS=1
# WHISPER_MEM_LIMIT=1g

# CPU threads (CTranslate2 decides when unset). Use the number of physical cores. A value saved on the /admin/ page beats this one.
# WHISPER_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, longest audio, silence filter, base model, number format,
# load at start) are set on the /admin/ Settings card and saved in settings.json. These variables are only a starting
# value for run.bat; compose does not pass them. A saved value wins.
# WHISPER_UPDATE_CHECK_HOURS=6
# WHISPER_MAX_INFLIGHT=
# WHISPER_CACHE_SIZE=256
# WHISPER_MAX_SECONDS=150
# WHISPER_VAD_FILTER=0
# WHISPER_MODEL=base.en
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_WARM=1

# run.bat only (compose sets these itself): bind address.
# WHISPER_HOST=127.0.0.1
# Where tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# WHISPER_TOKENS_FILE=tokens.json
# WHISPER_WEB_DIR=web
